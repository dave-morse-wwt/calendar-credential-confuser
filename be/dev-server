
# Run from this script's directory

export PYTHONPATH=src


export GOOGLE_OAUTH_JSON=$(op read op://Private/calendar-credential-confuser/JSON | jq -c .)
# Do Not set OAUTHLIB_INSECURE_TRANSPORT in production
# allows http instead of https
export OAUTHLIB_INSECURE_TRANSPORT=1

# Postgres Database Connection
DB_USER=$(yq .auth.username ../k8s/postgres/values.yaml)
DB_NAME=$(yq .auth.database ../k8s/postgres/values.yaml)
DB_PASSWORD=$(op read op://Private/calendar-credential-confuser/.auth.password)
DB_HOST=localhost
DB_PORT=5432
export DB_URL="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

export JWT_SECRET_KEY=$(op read op://Private/calendar-credential-confuser/JWT_SECRET_KEY)
export COOKIE_SECRET_KEY=$(op read op://Private/calendar-credential-confuser/COOKIE_SECRET_KEY)

uv run fastapi dev src/main.py
